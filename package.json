{
  "name": "studysprint",
  "version": "2.0.0",
  "private": true,
  "description": "A connected, browser-local study planner and assignment tracker",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "check": "node scripts/check.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/test-browser.cjs",
    "build": "node scripts/build.cjs",
    "verify": "npm run check && npm test && npm run build",
    "demo:gate": "node scripts/demonstrate-gate.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10"
  }
}
